APP_NAME=SynCode
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/SynCode/public
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syncode
DB_USERNAME=root
DB_PASSWORD=
# Set this to your MySQL socket when needed (for example on macOS XAMPP).
DB_SOCKET=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@syncode.test
MAIL_FROM_NAME="SynCode"

DEMO_ACCOUNTS_ENABLED=false
DEMO_CONTENT_ENABLED=false
DB_DUMP_BINARY=mysqldump
TRUSTED_PROXIES=
